   "source": [
    "import cv2 as cv\n",
    "from ultralytics import YOLO\n",
    "model = YOLO(\"yolov8n.pt\")\n",
    "sample=cv.imread(\"images.jpg\")\n",
    "detection=model(sample)\n",
    "cv.imshow(\"Objects\", detection[0].plot())\n",
    "cv.waitKey(0)\n",
    "cv.destroyAllWindows"
   ]
